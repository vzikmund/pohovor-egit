parameters:
	voucher:
		apiValidity: '1 year'
		minAmount: 10000   # 100 Kč
		maxAmount: 1000000 # 10 000 Kč


application:
	mapping: App\Presentation\*\**Presenter


latte:
	strictTypes: true
	extensions:
		- App\Presentation\Accessory\LatteExtension


session:
	expiration: 14 days


di:
	export:
		parameters: false
		tags: false
