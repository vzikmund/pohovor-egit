services:
	- App\Core\RouterFactory::createRouter
	- App\Model\SystemClock
	- App\Model\Voucher\VoucherFacade(
		apiValidity: %voucher.apiValidity%,
		minAmount: %voucher.minAmount%,
		maxAmount: %voucher.maxAmount%,
	)


search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Repository
			- *Generator
			- *Authenticator
		exclude:
			classes:
				- App\Model\Voucher\VoucherFacade
