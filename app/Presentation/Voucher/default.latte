{block title}Seznam poukazů{/block}

{block content}
<div class="page-head">
	<h1>Seznam poukazů</h1>
	<a n:href="create" class="button">Vydat poukaz</a>
</div>

<div class="table-wrap">
	<table class="list">
		<thead>
			<tr>
				<th>Kód</th>
				<th class="num">Hodnota</th>
				<th class="num">Zůstatek</th>
				<th>Platí do</th>
				<th>Stav</th>
				<th>Partner</th>
				<th>Zákazník</th>
			</tr>
		</thead>
		<tbody>
			<tr n:foreach="$vouchers as $voucher">
				<td><a n:href="detail, $voucher->id" class="code">{$voucher->code}</a></td>
				<td class="num">{$voucher->initialAmount|money}</td>
				<td class="num">{$voucher->balance|money}</td>
				<td>{$voucher->expiresAt|date:'j. n. Y'}</td>
				<td>{include '_status.latte', voucher: $voucher, now: $now}</td>
				<td>{$voucher->partnerName ?? 'Administrace'}</td>
				<td>{$voucher->customerEmail ?? '–'}</td>
			</tr>
		</tbody>
	</table>
</div>
